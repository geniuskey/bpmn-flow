<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_all" targetNamespace="http://example.com/bpmn-flow/fixtures">
  <bpmn:signal id="Sig_go" name="Go" />
  <bpmn:error id="Err_fail" name="Failure" errorCode="E1" />
  <bpmn:escalation id="Esc_late" name="Late" escalationCode="L1" />
  <bpmn:dataStore id="Store_archive" name="Archive DB" />
  <bpmn:category id="Cat_1">
    <bpmn:categoryValue id="CatVal_1" value="Preparation" />
  </bpmn:category>
  <bpmn:process id="Process_all" name="All elements" isExecutable="false">
    <bpmn:startEvent id="S" name="Signal received">
      <bpmn:outgoing>q1</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SED_1" signalRef="Sig_go" />
    </bpmn:startEvent>
    <bpmn:userTask id="Prepare" name="Prepare">
      <bpmn:incoming>q1</bpmn:incoming>
      <bpmn:outgoing>q2</bpmn:outgoing>
      <bpmn:property id="Prop_ph" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_1">
        <bpmn:sourceRef>DOR_1</bpmn:sourceRef>
        <bpmn:targetRef>Prop_ph</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DOA_1">
        <bpmn:targetRef>DSR_1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="B_timer" name="2 days" cancelActivity="false" attachedToRef="Prepare">
      <bpmn:outgoing>q9</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_b">
        <bpmn:timeDuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">P2D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:inclusiveGateway id="Or" name="Which?">
      <bpmn:incoming>q2</bpmn:incoming>
      <bpmn:outgoing>q3</bpmn:outgoing>
      <bpmn:outgoing>q4</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:sendTask id="Send" name="Send">
      <bpmn:incoming>q3</bpmn:incoming>
      <bpmn:outgoing>q5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:subProcess id="Sub" name="Review">
      <bpmn:incoming>q4</bpmn:incoming>
      <bpmn:outgoing>q6</bpmn:outgoing>
      <bpmn:startEvent id="SubS">
        <bpmn:outgoing>r1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:scriptTask id="Script" name="Score">
        <bpmn:incoming>r1</bpmn:incoming>
        <bpmn:outgoing>r2</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:endEvent id="SubE">
        <bpmn:incoming>r2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="r1" sourceRef="SubS" targetRef="Script" />
      <bpmn:sequenceFlow id="r2" sourceRef="Script" targetRef="SubE" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="B_error" attachedToRef="Sub">
      <bpmn:outgoing>q10</bpmn:outgoing>
      <bpmn:errorEventDefinition id="EED_b" errorRef="Err_fail" />
    </bpmn:boundaryEvent>
    <bpmn:complexGateway id="Join" name="Join">
      <bpmn:incoming>q5</bpmn:incoming>
      <bpmn:incoming>q6</bpmn:incoming>
      <bpmn:outgoing>q7</bpmn:outgoing>
    </bpmn:complexGateway>
    <bpmn:intermediateThrowEvent id="Notify" name="Notify">
      <bpmn:incoming>q7</bpmn:incoming>
      <bpmn:outgoing>q8</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SED_2" signalRef="Sig_go" />
    </bpmn:intermediateThrowEvent>
    <bpmn:callActivity id="Call" name="Archive" calledElement="ArchiveProcess">
      <bpmn:incoming>q8</bpmn:incoming>
      <bpmn:outgoing>q11</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="Done" name="Done">
      <bpmn:incoming>q11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="Remind" name="Remind">
      <bpmn:incoming>q9</bpmn:incoming>
      <bpmn:outgoing>q12</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="Reminded" name="Reminded">
      <bpmn:incoming>q12</bpmn:incoming>
      <bpmn:escalationEventDefinition id="EsED_1" escalationRef="Esc_late" />
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="Handle" name="Handle failure">
      <bpmn:incoming>q10</bpmn:incoming>
      <bpmn:outgoing>q13</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:endEvent id="Failed" name="Failed">
      <bpmn:incoming>q13</bpmn:incoming>
      <bpmn:errorEventDefinition id="EED_e" errorRef="Err_fail" />
    </bpmn:endEvent>
    <bpmn:dataObjectReference id="DOR_1" name="Request" dataObjectRef="DO_1" />
    <bpmn:dataObject id="DO_1" />
    <bpmn:dataStoreReference id="DSR_1" name="Archive DB" dataStoreRef="Store_archive" />
    <bpmn:sequenceFlow id="q1" sourceRef="S" targetRef="Prepare" />
    <bpmn:sequenceFlow id="q2" sourceRef="Prepare" targetRef="Or" />
    <bpmn:sequenceFlow id="q3" sourceRef="Or" targetRef="Send">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">notify</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="q4" sourceRef="Or" targetRef="Sub">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">review</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="q5" sourceRef="Send" targetRef="Join" />
    <bpmn:sequenceFlow id="q6" sourceRef="Sub" targetRef="Join" />
    <bpmn:sequenceFlow id="q7" sourceRef="Join" targetRef="Notify" />
    <bpmn:sequenceFlow id="q8" sourceRef="Notify" targetRef="Call" />
    <bpmn:sequenceFlow id="q9" sourceRef="B_timer" targetRef="Remind" />
    <bpmn:sequenceFlow id="q10" sourceRef="B_error" targetRef="Handle" />
    <bpmn:sequenceFlow id="q11" sourceRef="Call" targetRef="Done" />
    <bpmn:sequenceFlow id="q12" sourceRef="Remind" targetRef="Reminded" />
    <bpmn:sequenceFlow id="q13" sourceRef="Handle" targetRef="Failed" />
    <bpmn:textAnnotation id="Note">
      <bpmn:text>Starts when the "Go" signal is broadcast</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_1" sourceRef="Note" targetRef="S" />
    <bpmn:group id="Grp_1" categoryValueRef="CatVal_1" />
  </bpmn:process>
