<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_multi" targetNamespace="http://example.com/bpmn-flow/fixtures">
  <bpmn:process id="Process_multi" name="Order" isExecutable="false">
    <bpmn:startEvent id="Start_m">
      <bpmn:outgoing>m1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="Fulfil" name="Fulfil order">
      <bpmn:incoming>m1</bpmn:incoming>
      <bpmn:outgoing>m2</bpmn:outgoing>
      <bpmn:startEvent id="FS">
        <bpmn:outgoing>f1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="Pick" name="Pick items">
        <bpmn:incoming>f1</bpmn:incoming>
        <bpmn:outgoing>f2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="FE">
        <bpmn:incoming>f2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="f1" sourceRef="FS" targetRef="Pick" />
      <bpmn:sequenceFlow id="f2" sourceRef="Pick" targetRef="FE" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_m">
      <bpmn:incoming>m2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="m1" sourceRef="Start_m" targetRef="Fulfil" />
    <bpmn:sequenceFlow id="m2" sourceRef="Fulfil" targetRef="End_m" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_main">
    <bpmndi:BPMNPlane id="Plane_main" bpmnElement="Process_multi">
      <bpmndi:BPMNShape id="Start_m_di" bpmnElement="Start_m"><dc:Bounds x="152" y="102" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Fulfil_di" bpmnElement="Fulfil" isExpanded="false"><dc:Bounds x="240" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_m_di" bpmnElement="End_m"><dc:Bounds x="392" y="102" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="m1_di" bpmnElement="m1"><di:waypoint x="188" y="120" /><di:waypoint x="240" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="m2_di" bpmnElement="m2"><di:waypoint x="340" y="120" /><di:waypoint x="392" y="120" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="Diagram_fulfil">
    <bpmndi:BPMNPlane id="Plane_fulfil" bpmnElement="Fulfil">
      <bpmndi:BPMNShape id="FS_di" bpmnElement="FS"><dc:Bounds x="152" y="102" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pick_di" bpmnElement="Pick"><dc:Bounds x="240" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FE_di" bpmnElement="FE"><dc:Bounds x="392" y="102" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="188" y="120" /><di:waypoint x="240" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="340" y="120" /><di:waypoint x="392" y="120" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
