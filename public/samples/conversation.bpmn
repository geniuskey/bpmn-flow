  <bpmn:process id="Process_buyer" isExecutable="false" />
  <bpmndi:BPMNDiagram id="Diagram_conv">
    <bpmndi:BPMNPlane id="Plane_conv" bpmnElement="Collab_conv">
      <bpmndi:BPMNShape id="Buyer_di" bpmnElement="Buyer" isHorizontal="true"><dc:Bounds x="100" y="60" width="500" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Seller_di" bpmnElement="Seller" isHorizontal="true"><dc:Bounds x="100" y="300" width="230" height="80" /></bpmndi:BPMNShape>
