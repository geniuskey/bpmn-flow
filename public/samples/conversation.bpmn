    <bpmn:conversationLink id="CL_1" sourceRef="Buyer" targetRef="Conv_1" />
    <bpmn:conversationLink id="CL_2" sourceRef="Conv_1" targetRef="Seller" />
    <bpmn:conversationLink id="CL_3" sourceRef="Buyer" targetRef="Conv_2" />
    <bpmn:conversationLink id="CL_4" sourceRef="Conv_2" targetRef="Bank" />
