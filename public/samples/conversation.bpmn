      <bpmndi:BPMNShape id="Conv_1_di" bpmnElement="Conv_1"><dc:Bounds x="190" y="198" width="50" height="43" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Conv_2_di" bpmnElement="Conv_2"><dc:Bounds x="460" y="198" width="50" height="43" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="CL_1_di" bpmnElement="CL_1"><di:waypoint x="215" y="140" /><di:waypoint x="215" y="198" /></bpmndi:BPMNEdge>
