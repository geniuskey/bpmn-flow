<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_simple" targetNamespace="http://example.com/bpmn-flow/fixtures">
  <bpmn:process id="Process_simple" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Order received">
      <bpmn:outgoing>Flow_a</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_check" name="Check order">
      <bpmn:documentation>Verify stock and payment.</bpmn:documentation>
      <bpmn:incoming>Flow_a</bpmn:incoming>
      <bpmn:outgoing>Flow_b</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_1" name="Order handled">
      <bpmn:incoming>Flow_b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_a" sourceRef="Start_1" targetRef="Task_check" />
    <bpmn:sequenceFlow id="Flow_b" sourceRef="Task_check" targetRef="End_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_simple">
    <bpmndi:BPMNPlane id="Plane_simple" bpmnElement="Process_simple">
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1">
        <dc:Bounds x="152" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="133" y="145" width="74" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_check_di" bpmnElement="Task_check">
        <dc:Bounds x="240" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_1_di" bpmnElement="End_1">
        <dc:Bounds x="392" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="375" y="145" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_a_di" bpmnElement="Flow_a">
        <di:waypoint x="188" y="120" />
        <di:waypoint x="240" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_b_di" bpmnElement="Flow_b">
        <di:waypoint x="340" y="120" />
        <di:waypoint x="392" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
